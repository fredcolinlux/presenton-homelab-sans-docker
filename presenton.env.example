# Exemple de configuration Presenton (installation native Debian 13)
# Copier vers /etc/presenton/presenton.env et ajuster.
# Les secrets ne doivent pas être commités. Droits recommandés : 0640, propriétaire root:presenton.

# --- Chemins obligatoires ---
APP_DATA_DIRECTORY=/var/lib/presenton/app_data
TEMP_DIRECTORY=/var/lib/presenton/tmp
USER_CONFIG_PATH=/var/lib/presenton/app_data/userConfig.json
EXPORT_PACKAGE_ROOT=/opt/presenton/presentation-export
PRESENTON_APP_ROOT=/opt/presenton

# Caches Hugging Face / FastEmbed / icônes (Mem0 + recherche d'icônes)
HF_HOME=/var/cache/presenton/huggingface
FASTEMBED_CACHE_PATH=/var/cache/presenton/fastembed
PRESENTON_FASTEMBED_ICON_CACHE_DIR=/var/cache/presenton/fastembed-icons

# URL publique, telle que vue dans le navigateur (liens de téléchargement / prévisualisation)
# Exemples : http://IP_PRESENTON:5001  ou  https://presenton.home.arpa
PRESENTON_PUBLIC_URL=http://127.0.0.1:5001

# Next.js doit appeler FastAPI en boucle locale, sans passer par nginx
FAST_API_INTERNAL_URL=http://127.0.0.1:8000

# Chromium Debian (paquet chromium). Ajuster si le binaire est ailleurs.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Migrations SQLite/Postgres/MySQL au démarrage (laisser true sauf gestion externe)
MIGRATE_DATABASE_ON_STARTUP=true
# Laisser vide pour SQLite dans APP_DATA_DIRECTORY/fastapi.db
# Exemples :
# DATABASE_URL=sqlite:////var/lib/presenton/app_data/fastapi.db
# DATABASE_URL=postgresql://presenton:SECRET@127.0.0.1:5432/presenton
# DATABASE_URL=mysql://presenton:SECRET@127.0.0.1:3306/presenton
# DATABASE_URL=

# --- Compte administrateur initial (optionnel) ---
# Si ces deux variables sont définies au premier démarrage, le compte admin est créé
# automatiquement. Sinon, l'écran de configuration du navigateur s'en charge.
# Nom : au moins 3 caractères. Mot de passe : au moins 8 caractères.
# AUTH_USERNAME=admin
# AUTH_PASSWORD=changer-ce-mot-de-passe
# Rotation ultérieure (ne pas laisser à true en permanence) :
# AUTH_OVERRIDE_FROM_ENV=false
# RESET_AUTH=false

# --- Confidentialité / réseau ---
DISABLE_ANONYMOUS_TRACKING=true
# Galerie Community (cloud Presenton). false = pas d'appels à api.presenton.ai
PRESENTON_COMMUNITY_ENABLED=false
# Modes UI : both (défaut), standard, smart
PRESENTATION_GENERATION_MODE=both

# --- LLM ---
# Valeurs possibles :
# openai, deepseek, google, vertex, azure, bedrock, openrouter, fireworks,
# together, cerebras, anthropic, litellm, lmstudio, ollama, custom, codex
# Remplacez IP_OLLAMA par l'adresse de la machine qui fait tourner Ollama.
# Forme de l'URL (vérifiée dans servers/fastapi/utils/ollama.py et tests) :
#   - port par défaut d'Ollama : 11434
#   - si Ollama est sur la même machine : http://127.0.0.1:11434
#   - un préfixe de chemin est accepté : Presenton appelle {OLLAMA_URL}/api/tags et /api/pull
#   - sans slash final (le listing le retire, mais le client LLM fait OLLAMA_URL + "/v1"
#     dans llm_config.py sans le retirer : un slash final donnerait ...//v1)
#   - sans suffixe /api (sinon .../api/api/tags)
#   - sans query ni fragment ; les redirections HTTP ne sont pas suivies
LLM=ollama
OLLAMA_URL=http://IP_OLLAMA:11434
# Modèle texte recommandé (catalogue testé Presenton, ~6,6 Go) :
OLLAMA_MODEL=qwen3.5:9b
# Ne pas laisser start.js installer Ollama : il tourne déjà sur une autre machine.
START_OLLAMA=false

# Alternative si LLM=ollama posait problème :
# le mode custom parle uniquement à l'API OpenAI, donc l'URL DOIT inclure /v1.
# LLM=custom
# CUSTOM_LLM_URL=http://IP_OLLAMA:11434/v1
# CUSTOM_LLM_API_KEY=ollama
# CUSTOM_MODEL=qwen3.5:9b

# Exemple OpenAI :
# LLM=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# Exemple Google Gemini :
# LLM=google
# GOOGLE_API_KEY=
# GOOGLE_MODEL=models/gemini-2.0-flash

# Exemple Anthropic :
# LLM=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Exemple API compatible OpenAI (vLLM, llama.cpp, proxy, etc.) :
# LLM=custom
# CUSTOM_LLM_URL=http://127.0.0.1:8080/v1
# CUSTOM_LLM_API_KEY=
# CUSTOM_MODEL=qwen3.5:9b
# Le serveur doit exposer POST /v1/chat/completions.

# LM Studio local :
# LLM=lmstudio
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=

# LiteLLM :
# LLM=litellm
# LITELLM_BASE_URL=
# LITELLM_API_KEY=
# LITELLM_MODEL=gpt-4.1

# Autres fournisseurs (décommenter selon le cas) :
# DEEPSEEK_API_KEY=  DEEPSEEK_MODEL=deepseek-chat  DEEPSEEK_BASE_URL=https://api.deepseek.com
# VERTEX_API_KEY=  VERTEX_MODEL=gemini-2.5-flash  VERTEX_PROJECT=  VERTEX_LOCATION=  VERTEX_BASE_URL=
# AZURE_OPENAI_API_KEY=  AZURE_OPENAI_MODEL=  AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_ENDPOINT=  AZURE_OPENAI_BASE_URL=  AZURE_OPENAI_DEPLOYMENT=
# BEDROCK_REGION=us-east-1  BEDROCK_MODEL=  BEDROCK_API_KEY=
# BEDROCK_AWS_ACCESS_KEY_ID=  BEDROCK_AWS_SECRET_ACCESS_KEY=  BEDROCK_AWS_SESSION_TOKEN=  BEDROCK_PROFILE_NAME=
# OPENROUTER_API_KEY=  OPENROUTER_MODEL=openai/gpt-4o  OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# FIREWORKS_API_KEY=  FIREWORKS_MODEL=  FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# TOGETHER_API_KEY=  TOGETHER_MODEL=  TOGETHER_BASE_URL=https://api.together.ai/v1
# CEREBRAS_API_KEY=  CEREBRAS_MODEL=llama-3.3-70b  CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# CODEX_MODEL=

# --- Images des diapositives : ComfyUI (Ollama images non disponible) ---
# Presenton n'accepte qu'UNE URL (COMFYUI_URL) et exige COMFYUI_WORKFLOW
# (chaîne JSON au format API, pas un chemin de fichier).
# Le .json est chargé par scripts/presenton-fastapi-start.sh depuis
# /etc/presenton/comfyui-workflow.json (sudo ./comfyui/install-workflow-on-presenton.sh).
# COMFYUI_URL pointe vers le proxy nginx local : 5070 Ti principale,
# 3070 Ti uniquement en secours (voir comfyui/nginx-comfyui-upstream.conf).
IMAGE_PROVIDER=comfyui
COMFYUI_URL=http://127.0.0.1:8188
# Ne pas coller le JSON ici : le script de lancement le lit depuis le fichier.
# COMFYUI_WORKFLOW=
ENABLE_PARALLEL_IMAGE_GENERATION=false

# Pont optionnel vers une API d'images compatible OpenAI
# (la génération d'images native d'Ollama est expérimentale et souvent absente) :
# IMAGE_PROVIDER=openai_compatible
# OPENAI_COMPAT_IMAGE_BASE_URL=http://IP_OLLAMA:11434/v1
# OPENAI_COMPAT_IMAGE_API_KEY=ollama
# OPENAI_COMPAT_IMAGE_MODEL=
# DISABLE_IMAGE_GENERATION=true
# IMAGE_PROVIDER=pexels
# PEXELS_API_KEY=

# --- Mémoire de présentation (Mem0, local) ---
MEM0_ENABLED=true
MEM0_DIR=/var/lib/presenton/app_data/mem0
MEM0_EMBEDDER_PROVIDER=fastembed
MEM0_EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
MEM0_EMBEDDING_DIMS=384
MEM0_SPACY_MODEL=en_core_web_sm
MEM0_REQUIRE_SPACY_MODEL=true
# Mem0 ajoute /v1 tout seul s'il manque (services/mem0_oss_memory.py).
# Sans ces variables, il reprendrait OLLAMA_URL / OLLAMA_MODEL (correct aussi).
MEM0_LLM_BASE_URL=http://IP_OLLAMA:11434
MEM0_LLM_API_KEY=ollama
MEM0_LLM_MODEL=qwen3.5:9b

# --- Analyse de documents (LiteParse) ---
LITEPARSE_DPI=120
LITEPARSE_NUM_WORKERS=1

# --- Recherche web (optionnel) ---
# WEB_GROUNDING=false
# WEB_SEARCH_PROVIDER=auto
# WEB_SEARCH_MAX_RESULTS=5
# SEARXNG_BASE_URL=
# TAVILY_API_KEY=
# EXA_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SERPER_API_KEY=

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
